# Copy to .env and edit. Only set what you actually use — every var is optional.

# Default provider: lmstudio, ollama, llamacpp, openrouter, grok, openai, groq,
# together, deepinfra, mistral, or any custom name you configure below.
LLM_PROVIDER=lmstudio

# Default model id, exactly as the chosen provider names it.
# For local light work, gemma-4-e2b-it (fastest) or gemma-4-e4b-it (a bit smarter)
# are good picks; on Apple Silicon use the -mlx build, e.g. gemma-4-e2b-it-mlx.
LLM_MODEL=gemma-4-e2b-it

# Request timeout in seconds (a big local model on modest hardware can be slow).
LLM_TIMEOUT=300

# Caps for path/glob file reads (summarize/classify/extract with path=...):
# OFFLOAD_MAX_FILES=50
# OFFLOAD_MAX_CHARS=100000

# --- Per-provider overrides ---------------------------------------------------
# Point LM Studio at a LAN host instead of localhost (run Claude and LM Studio on
# different machines):
# LMSTUDIO_BASE_URL=http://192.168.1.50:1234/v1

# Hosted providers — set the key for whichever you use:
# OPENROUTER_API_KEY=sk-or-...
# XAI_API_KEY=xai-...
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk-...
# TOGETHER_API_KEY=...

# Optional OpenRouter ranking headers:
# OPENROUTER_REFERER=https://your-site.example
# OPENROUTER_TITLE=mcp-llm-offload

# --- A floor under the backend ------------------------------------------------
# A second backend to try when the first is unreachable, timing out, overloaded or
# out of credit. Only availability failures fall through (connection refused, a
# timeout, 429, 402, 5xx); a bad key or an unserved model is reported as itself.
# LLM_FALLBACK_PROVIDER=lmstudio

# --- Hermes bot (agent_mcp.py, and usable as a backend) -----------------------
# The bot's gateway, its profile's API_SERVER_KEY, and the profile name.
# HERMES_BASE_URL=http://192.168.1.50:8649/v1
# HERMES_API_KEY=...
# HERMES_BOT=github

# --- Spreading work across two backends ---------------------------------------
# single = every op goes to LLM_PROVIDER. spread = cheap structured ops
# (summarize/classify/extract/translate/rewrite) go light, generation goes heavy.
# OFFLOAD_ROUTING=spread
# OFFLOAD_LIGHT_PROVIDER=lmstudio
# OFFLOAD_LIGHT_BASE_URL=http://192.168.1.50:1234/v1
# OFFLOAD_HEAVY_PROVIDER=hermes
# OFFLOAD_HEAVY_BASE_URL=

# --- Custom provider example --------------------------------------------------
# Any OpenAI-compatible endpoint works. Pick a name (e.g. "foo"), then call tools
# with provider="foo":
# FOO_BASE_URL=https://api.example.com/v1
# FOO_API_KEY=...
